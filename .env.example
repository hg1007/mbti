# ============================================
# AI 题目生成器配置
# 支持任意 OpenAI 兼容的大模型 API 网关
# ============================================

# API 接口地址（必须包含完整路径，如 /v1/chat/completions）
# 示例：
#   阿里云 DashScope：https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
#   DeepSeek：https://api.deepseek.com/v1/chat/completions
#   私有化网关：https://your-gateway.com/v1/chat/completions
API_URL=xxx

# API Key
API_KEY=your_api_key_here

# 模型名称（根据网关支持的模型填写）
# 示例：qwen-plus, qwen3.7-max, deepseek-chat, gpt-4o 等
MODEL=xxxx

# 最大 Token 数（默认 4096）
MAX_TOKENS=xxxx
